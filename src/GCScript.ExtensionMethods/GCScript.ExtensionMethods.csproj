<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net48</TargetFrameworks>
		<LangVersion>12.0</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- CS1591 (membro público sem comentário XML) fica desligado enquanto os membros antigos não forem documentados; os demais avisos de documentação, como tag param com nome errado, continuam valendo. -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Authors>GCScript</Authors>
		<Company>GCScript</Company>
		<Copyright>GCScript</Copyright>
		<Title>GCScript Extension Methods</Title>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageProjectUrl>https://github.com/gcscript/GCScript.ExtensionMethods</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<PackageTags>GCScript Extension Methods</PackageTags>
		<PackageVersion>1.4.1</PackageVersion>
		<RepositoryUrl>https://github.com/gcscript/GCScript.ExtensionMethods</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="..\..\LICENSE.txt">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SimMetrics.Net" Version="1.0.5" />
	</ItemGroup>

	<!-- .NET Framework não tem AesGcm nem Span: o BouncyCastle cobre o AES-GCM, o System.Memory traz Span e o PolySharp gera os atributos e tipos que o compilador exige (Index, Range, NotNullWhen, required). -->
	<ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
	  <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
	  <PackageReference Include="System.Memory" Version="4.6.3" />
	  <PackageReference Include="PolySharp" Version="1.16.0">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Update="LICENSE.txt">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
